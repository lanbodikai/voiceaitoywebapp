# West serves its own health check; the East certificate issuer owns challenges.
http://api.260926731.xyz {
  handle /health {
    reverse_proxy 127.0.0.1:8787
  }
  handle / {
    rewrite * /health
    reverse_proxy 127.0.0.1:8787
  }
  handle /.well-known/acme-challenge/* {
    reverse_proxy http://100.51.236.202:80
  }
  respond 404
}
