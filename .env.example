VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:8787
# Optional production migration settings. Leave unset to retain Oracle routing.
# VITE_VOICE_STREAM_URL=wss://YOUR-VOICE-HOST/web/voice-stream
# Server-side only (Vercel): VOICE_API_ORIGIN=https://YOUR-VOICE-HOST/web
# Voice runtime only: enable Jev after deploying consent migration and setting
# a freshly rotated TypeSafe key in the server secret store (never in VITE_*).
# JEV_GRADING_ENABLED=true
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-1.13.0
